{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "WowEmu.AuthServer.AuthSession": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },

  "AuthServer": {
    "BindAddress": "0.0.0.0",
    "Port": 3724,

    "//ConnectionString": [
      "Empty means the local Docker default in docker-compose.yml.",
      "WOWEMU_AUTH_CONNECTION overrides whatever is set here."
    ],
    "ConnectionString": "",

    "RealmRefreshSeconds": 60,
    "ApplyMigrationsOnStartup": true
  }
}
