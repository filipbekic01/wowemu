{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "WowEmu.WorldServer.WorldSession": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  },

  "WorldServer": {
    "BindAddress": "0.0.0.0",
    "Port": 8085,

    "//RealmId": "Must match the realmlist row the client picked, or the handshake is rejected.",
    "RealmId": 1,

    "//ConnectionString": "Empty means the local Docker default. WOWEMU_AUTH_CONNECTION overrides it.",
    "ConnectionString": "",

    "ClientCacheVersion": 0,
    "Expansion": 2
  }
}
